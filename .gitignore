# =============================================================================
# SignalScope — .gitignore
# =============================================================================

# --- Run outputs (per-sample results — never committed) ----------------------
samples/
*.report.html

# --- Raw signal input (symlink / large external data) ------------------------
pod5_pass/

# --- Large tool distributions (downloaded via setup — see README) ------------
tools/

# --- Models (chemistry-matched; downloaded separately — see README) ----------
models/

# --- Large reference bundles (downloaded via setup — see README) -------------
resources/igv_genome/
resources/reference/
vep_cache/

# --- Reference FASTA / index files anywhere (users provide) ------------------
*.fa
*.fasta
*.fa.fai
*.fai
*.2bit
*.mmi

# small shipped resources kept: resources/panels, gene_context, reporting

# --- GenCC source data (regenerated by build script — see README) ------------
pipeline/scripts/gene_context_sources/

# --- Development archive (local only) ----------------------------------------
_dev_archive/
*.bak
*.bak_*

# --- Snakemake internals -----------------------------------------------------
.snakemake/

# --- Conda / Python ----------------------------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- Logs & temp -------------------------------------------------------------
*.stdout
*.stderr
*_time_mem.log
*.log
.X*-lock

# --- OS / editor -------------------------------------------------------------
.DS_Store
*.swp
*~
pipeline/config.yaml
config.yaml
